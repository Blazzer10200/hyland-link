<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds against the MelonLoader + IL2CPP assemblies in a Schedule I install (the game must have run with
       MelonLoader once so Il2CppAssemblies exists). Override with: dotnet build -p:GamePath="D:\...\Schedule I" -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HylandNotify</AssemblyName>
    <RootNamespace>HylandNotify</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GamePath>
    <Il2Cpp>$(GamePath)\MelonLoader\Il2CppAssemblies</Il2Cpp>
  </PropertyGroup>
  <ItemGroup>
    <!-- The HUD's glass art, UI builders and sprite cache, compiled in so every glass edge matches Hyland HUD. -->
    <Compile Include="..\hud\src\Art.cs" Link="shared\Art.cs" />
    <Compile Include="..\hud\src\Ui.cs" Link="shared\Ui.cs" />
    <Compile Include="..\hud\src\Sprites.cs" Link="shared\Sprites.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(GamePath)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GamePath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppScheduleOne.Core.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppFishNet.Runtime.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
</Project>
